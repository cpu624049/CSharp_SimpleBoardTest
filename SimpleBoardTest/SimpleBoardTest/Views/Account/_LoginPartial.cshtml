@{
	var userId = Context.Session.GetInt32("UserId");
	var userName = Context.Session.GetString("UserName");
}

<ul class="navbar-nav">
	@if (userId != null)
	{
		<li class="nav-item">
			<span class="nav-link text-dark">
				<a class="nav-link fas fa-user" asp-controller="Account" asp-action="Edit"> @userName 님</a>
			</span>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">
				<i class="fas fa-sign-out-alt"></i> 로그아웃
			</a>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="Register">
				<i class="fas fa-user-plus"></i> 회원가입
			</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
				<i class="fas fa-sign-in-alt"></i> 로그인
			</a>
		</li>
	}
</ul>
