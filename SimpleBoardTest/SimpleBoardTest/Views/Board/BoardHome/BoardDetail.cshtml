@model SimpleBoardTest.Models.Post

@{
	ViewData["Title"] = "게시글 상세";
}

<div class="contailner mt-4">

	<!-- ✅ 원글 정보 표시 -->
	@if (Model.ParentPost != null)
	{
		<div class="alert alert-light">
			🔁 원글:
			@if (string.IsNullOrWhiteSpace(Model.ParentPost.Title) || Model.ParentPost.Title == "[삭제된 글입니다]")
			{
				<a asp-controller="Board" asp-action="Details" asp-route-id="@Model.ParentPost.PostId" class="text-primary fw-bold">
					[삭제된 글입니다]
				</a>
			}
			else
			{
				<a asp-controller="Board" asp-action="Details" asp-route-id="@Model.ParentPost.PostId" class="text-primary fw-bold">
					@Model.ParentPost.Title
				</a>
			}
		</div>
	}

	<!-- ✅ 삭제된 글 표시 -->
	@if (Model.Title == "[삭제된 글입니다]" && Model.Content == "[삭제된 글입니다]")
	{
		<div class="alert alert-secondary">
			<strong>이 게시글은 삭제되었습니다.</strong>
		</div>
	}
	else
	{
		<!-- ✅ 게시글 기본 정보 -->
		<h2>@Model.Title</h2>
		<p><strong>작성자:</strong> @Model.User?.UserName</p>
		<p><strong>작성일:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
		<p><strong>수정일:</strong> @Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</p>
		<p><strong>조회수:</strong> @Model.ViewCount</p>

		<hr />

		<div>
			<p>@Model.Content</p>
		</div>
	}

	<hr />

	<!-- ✅ 답글 작성 버튼 (삭제된 글이면 비활성화) -->
	@if (!(Model.Title == "[삭제된 글입니다]" && Model.Content == "[삭제된 글입니다]"))
	{
		<div class="mb-3">
			<a asp-controller="Post" asp-action="PostCreate" asp-route-parentPostId="@Model.PostId" class="btn btn-outline-secondary">답글 작성</a>
		</div>
	}

	<!-- ✅ 답글 목록 -->
	@if (Model.Replies != null && Model.Replies.Any())
	{
		<div class="mt-4">
			<h4>답글 목록</h4>

			@foreach (var reply in Model.Replies)
			{
				<div class="card mb-2 ms-3">
					<div class="card-body">
						<h5 class="card-title">
							@if (reply.Title == "[삭제된 글입니다]")
							{
								<a asp-controller="Board" asp-action="Details" asp-route-id="@reply.PostId">
									[삭제된 글입니다]
								</a>
							}
							else
							{
								<a asp-controller="Board" asp-action="Details" asp-route-id="@reply.PostId">
									@reply.Title
								</a>
							}
						</h5>

						<p class="text-muted small">작성일 : @reply.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

						<!-- ✅ 답글 삭제 버튼 -->
						<form asp-controller="Post" asp-action="PostDelete" method="post">
							<input type="hidden" name="id" value="@reply.PostId" />
							<button type="submit" class="btn btn-sm btn-danger">삭제</button>
						</form>
					</div>
				</div>
			}
		</div>
	}

	<hr />

	<a asp-controller="Board" asp-action="BoardIndex">← 목록으로</a>
</div>
