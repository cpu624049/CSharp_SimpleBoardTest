@model IEnumerable<SimpleBoardTest.Models.Post>

@{
	ViewData["Title"] = "게시판 목록";
}
<div class="d-flex justify-content-between align-items-center mb-3">
	<h2>게시판</h2>
	<!-- ✅ 게시글 작성 버튼 -->
	<a class="btn btn-primary" asp-controller="Post" asp-action="PostCreate">
		글쓰기
	</a>
</div>

<table class="table table-bordered">
	<thead>
		<tr>
			<th>번호</th>
			<th>제목</th>
			<th>작성자</th>
			<th>조회수</th>
			<th>댓글 수</th>
			<th>작성일</th>
			<th>수정일</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var post in Model)
		{
			<tr>
				<td>@post.PostId</td>
				<td>
					<a href="@Url.Action("Details","Board",new { id = post.PostId })">@Html.Raw(post.Title)</a>
				</td>
				<td>@post.User?.UserName</td>
				<td>@post.ViewCount</td>
				<td>@post.Comments.Count()</td>
				<td>@post.CreatedAt.ToString("yyyy-MM-dd")</td>
				<td>@post.UpdatedAt?.ToString("yyyy-MM-dd")</td>
			</tr>
		}
	</tbody>
</table>