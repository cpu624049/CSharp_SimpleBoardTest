@model SimpleBoardTest.Models.Comment

@{
	var currentUserId = Context.Session.GetInt32("UserId");
	var isOwner = currentUserId != null && currentUserId == Model.UserId;

	// 대댓글 들여쓰기 계산
	var depth = ViewBag.CommentDepths != null && ViewBag.CommentDepths.ContainsKey(Model.CommentId)
		? ViewBag.CommentDepths[Model.CommentId]
		: 0;

	// depth 정의
	var depthClass = $"comment-depth-{depth}";

	var commentLikeCount = ViewBag.CommentLikeCounts?[Model.CommentId] ?? 0;
	var commentLiked = ViewBag.CommentLikedIds != null && ViewBag.CommentLikedIds.Contains(Model.CommentId);
	var likedClass = commentLiked ? "btn-danger" : "btn-outline-secondary";
}

<div class="card mb-2 @depthClass">
	<div class="card-body bg-light">

		<!-- 작성자 및 작성일 + 들여쓰기 -->
		<p class="mb-1">
			↳ 👤<strong>@Model.User?.UserName</strong>
			<small class="text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
		</p>

		<!-- 댓글 내용 -->
		@if (Model.IsDeleted)
		{
			<p class="text-muted fst-italic">[삭제된 댓글입니다]</p>
		}
		else
		{
			<p>@Model.Content</p>
		}

		<!-- ✅ 수정/삭제 버튼 : 작성자 본인일 때 & 삭제되지 않은 경우 -->
		@if (isOwner && !Model.IsDeleted)
		{
			<div class="d-flex gap-2 mb-2">
				<button class="btn btn-sm btn-outline-secondary" onclick="toggleEditForm(@Model.CommentId)">
					<i class="fas fa-edit"></i> 수정
				</button>

				<form asp-controller="comment" asp-action="Delete" method="post" class="d-inline ms-1" onsubmit="return confirl('댓글을 삭제하시겠습니까?');">
					<input type="hidden" name="commentId" value="@Model.CommentId" />
					<button type="submit" class="btn btn-sm btn-danger">
						<i class="fas fa-trash"></i> 삭제
					</button>
				</form>
			</div>

			<!-- ✅ 수정 폼 -->
			<div id="editForm-@Model.CommentId" class="mt-2 d-none">
				<form asp-controller="Comment" asp-action="Edit" method="post">
					<input type="hidden" name="commentId" value="@Model.CommentId" />
					<textarea class="form-control mb-2" name="content">@Model.Content</textarea>
					<button type="submit" class="btn btn-sm btn-success">저장</button>
					<button type="button" class="btn btn-sm btn-secondary" onclick="toggleEditForm(@Model.CommentId)">취소</button>
				</form>
			</div>
		}

		<!-- ✅ 좋아요 기능 -->
		<div class="d-flex gap-2 mb-2">
			<button class="btn btn-sm @likedClass like-btn" data-type="Comment" data-id="@Model.CommentId">
				❤ 좋아요 (<span class="like-count">@commentLikeCount</span>)
			</button>
		</div>

		<!-- ✅ 댓글 입력 : 삭제되지 않은 경우에만 가능 -->
		@if (!Model.IsDeleted)
		{
			<button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="toggleReplyForm(@Model.CommentId)">
				<i class="fas fa-reply"></i> 댓글 작성
			</button>

			<div id="replyForm-@Model.CommentId" class="mt-2 d-none">
				<form asp-controller="Comment" asp-action="Create" method="post">
					<input type="hidden" name="postId" value="@Model.PostId" />
					<input type="hidden" name="parentCommentId" value="@Model.CommentId" />
					<textarea class="form-control mb-2" name="content" rows="2" placeholder="댓글을 입력하세요..."></textarea>
					<button type="submit" class="btn btn-sm btn-primary">작성</button>
					<button type="button" class="btn btn-sm btn-secondary" onclick="toggleReplyForm(@Model.CommentId)">취소</button>
				</form>
			</div>
		}

	</div>
</div>

<!-- ✅ 댓글 재귀 출력 -->
@if (Model.Replies != null && Model.Replies.Any())
{
	foreach (var reply in Model.Replies.OrderBy(r => r.CreatedAt))
	{
		<partial name="~/Views/Board/Comment/_CommentPartial.cshtml" model="reply" />
	}
}
