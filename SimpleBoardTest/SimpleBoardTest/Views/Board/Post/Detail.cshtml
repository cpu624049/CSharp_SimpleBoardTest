@model SimpleBoardTest.Models.Post

@{
	ViewData["Title"] = "게시글 상세";
	var currentUserId = Context.Session.GetInt32("UserId");
	var isOwner = currentUserId != null && currentUserId == Model.UserId;
	var commentDepths = ViewBag.CommentDepths as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid">

	<!-- ✅ 원글 정보 (답글인 경우) -->
	@if (Model.ParentPost != null)
	{
		<div class="alert alert-light">
			🔁 원글:
			<a asp-controller="Board" asp-action="Detail" asp-route-id="@Model.ParentPost.PostId" class="text-primary fw-bold">
				@(string.IsNullOrWhiteSpace(Model.ParentPost.Title) ? "[삭제된 글입니다]" : Model.ParentPost.Title)
			</a>
		</div>
	}

	<!-- ✅ 게시글 내용 -->
	<div class="card">
		<div class="card-header">
			<h3 class="card-title">@Model.Title</h3>
		</div>
		<div class="card-body">
			<p><strong>작성자:</strong> @Model.User?.UserName</p>
			<p><strong>작성일:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
			<p><strong>수정일:</strong> @Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</p>
			<p><strong>조회수:</strong> @Model.ViewCount</p>
			<hr />
			<p>@Model.Content</p>
		</div>
		<div class="card-footer">
			@if (isOwner)
			{
				<a asp-controller="Post" asp-action="Edit" asp-route-id="@Model.PostId" class="btn btn-sm btn-warning me-2">
					<i class="fas fa-edit"></i> 수정
				</a>
				<form asp-controller="Post" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('정말 삭제하시겠습니까?');">
					<input type="hidden" name="id" value="@Model.PostId" />
					<button type="submit" class="btn btn-sm btn-danger">
						<i class="fas fa-trash"></i> 삭제
					</button>
				</form>
			}
		</div>
	</div>

	<!-- ✅ 댓글 입력 -->
	<div class="mt-5">
		<h4><i class="fas fa-comments"></i> 댓글 작성</h4>
		<form asp-controller="Comment" asp-action="Create" method="post">
			<input type="hidden" name="postId" value="@Model.PostId" />
			<textarea class="form-control mb-2" name="content" rows="3" placeholder="댓글을 입력하세요"></textarea>
			<button type="submit" class="btn btn-sm btn-primary">댓글 작성</button>
		</form>
	</div>

	<!-- ✅ 댓글 목록 -->
	@if (Model.Comments != null && Model.Comments.Any())
	{
		<hr />
		<h5 class="mt-4 mb-3">댓글 목록</h5>
		@foreach (var comment in Model.Comments)
		{
			var depth = commentDepths.ContainsKey(comment.CommentId) ? commentDepths[comment.CommentId] : 0;
			var indentClass = "ms-" + (depth * 3);

			<div class="card mb-2 @indentClass">
				<div class="card-body bg-light">
					<p class="mb-1"><strong>@comment.User?.UserName</strong> <small class="text-muted">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small></p>
					<p>@comment.Content</p>

					@if (currentUserId == comment.UserId)
					{
						<button class="btn btn-sm btn-outline-secondary" onclick="toggleEditForm(@comment.CommentId)">수정</button>
						<form asp-controller="Comment" asp-action="Delete" method="post" class="d-inline ms-1" onsubmit="return confirm('댓글을 삭제하시겠습니까?');">
							<input type="hidden" name="commentId" value="@comment.CommentId" />
							<button type="submit" class="btn btn-sm btn-danger">삭제</button>
						</form>

						<!-- 수정 폼 -->
						<div id="editForm-@comment.CommentId" class="mt-2 d-none">
							<form asp-controller="Comment" asp-action="Edit" method="post">
								<input type="hidden" name="commentId" value="@comment.CommentId" />
								<textarea class="form-control mb-2" name="content">@comment.Content</textarea>
								<button type="submit" class="btn btn-sm btn-success">저장</button>
								<button type="button" class="btn btn-sm btn-secondary" onclick="toggleEditForm(@comment.CommentId)">취소</button>
							</form>
						</div>
					}

					<!-- 대댓글 입력 -->
					<form asp-controller="Comment" asp-action="Create" method="post" class="mt-2">
						<input type="hidden" name="postId" value="@comment.PostId" />
						<input type="hidden" name="parentCommentId" value="@comment.CommentId" />
						<textarea class="form-control mb-1" name="content" rows="2" placeholder="대댓글 작성..."></textarea>
						<button type="submit" class="btn btn-sm btn-outline-primary">작성</button>
					</form>
				</div>
			</div>
		}
	}

	<!-- ✅ 답글 작성 -->
	@if (!(Model.Title == "[삭제된 글입니다]" && Model.Content == "[삭제된 글입니다]"))
	{
		<div class="mt-4 mb-2">
			<a asp-controller="Post" asp-action="Create" asp-route-parentPostId="@Model.PostId" class="btn btn-outline-secondary btn-sm">
				<i class="fas fa-reply"></i> 답글 작성
			</a>
		</div>
	}

	<!-- ✅ 답글 목록 -->
	@if (Model.Replies != null && Model.Replies.Any())
	{
		<h5 class="mt-4">답글 목록</h5>
		@foreach (var reply in Model.Replies)
		{
			var isReplyOwner = currentUserId != null && currentUserId == reply.UserId;
			<div class="card mb-2 ms-3">
				<div class="card-body">
					<h5 class="card-title">
						<a asp-controller="Board" asp-action="Detail" asp-route-id="@reply.PostId">
							@(reply.Title == "[삭제된 글입니다]" ? "[삭제된 글입니다]" : reply.Title)
						</a>
					</h5>
					<p class="text-muted small">작성일: @reply.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>

					@if (isReplyOwner)
					{
						<form asp-controller="Post" asp-action="Delete" method="post" onsubmit="return confirm('정말 삭제하시겠습니까?');">
							<input type="hidden" name="id" value="@reply.PostId" />
							<button type="submit" class="btn btn-sm btn-danger">삭제</button>
						</form>
					}
				</div>
			</div>
		}
	}

	<hr />
	<a asp-controller="Board" asp-action="Index" class="btn btn-secondary btn-sm">
		<i class="fas fa-list"></i> 목록으로
	</a>
</div>

@section Scripts {
	<script>
		function toggleEditForm(commentId) {
			const form = document.getElementById("editForm-" + commentId);
			if (form) form.classList.toggle("d-none");
		}
	</script>
}
