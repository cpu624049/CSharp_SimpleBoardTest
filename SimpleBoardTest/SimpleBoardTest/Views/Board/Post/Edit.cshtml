@model SimpleBoardTest.Models.Post
@{
	ViewData["Title"] = "게시글 수정";
}

<div class="card">
	<div class="card-header">
		<h3 class="card-title">게시글 수정</h3>
	</div>

	<div class="card-body">
		<form asp-action="Edit" method="post">
			<input type="hidden" asp-for="PostId" />
			<input type="hidden" asp-for="UserId" />
			<input type="hidden" asp-for="CreatedAt" />
			<input type="hidden" asp-for="UpdatedAt" />

			<!-- 제목 -->
			<div class="mb-3">
				<label asp-for="Title" class="form-label">제목</label>
				<input asp-for="Title" class="form-control" />
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>

			<!-- 내용 -->
			<div class="mb-3">
				<label asp-for="Content" class="form-label">내용</label>
				<textarea asp-for="Content" class="form-control" rows="6"></textarea>
				<span asp-validation-for="Content" class="text-danger"></span>
			</div>

			<!-- 버튼 -->
			<div class="mt-4">
				<button type="submit" class="btn btn-success btn-sm">
					<i class="fas fa-edit"></i> 수정
				</button>
				<a asp-controller="Board" asp-action="Index" class="btn btn-secondary btn-sm">
					<i class="fas fa-times"></i> 취소
				</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
