@model SimpleBoardTest.Models.Post

<div class="container mt-4">
	<h2>게시글 작성</h2>

	<form asp-action="Edit" method="post">
		<input type="hidden" asp-for="UserId" />

		<div class="mb-3">
			<label asp-for="Title" class="form-label">제목</label>
			<input asp-for="Title" class="form-control" />
		</div>

		<div class="mb-3">
			<label asp-for="Content" class="form-label">내용</label>
			<textarea asp-for="Content" class="form-control" rows="6"></textarea>
		</div>

		<button type="submit" class="btn btn-primary">작성</button>
		<a asp-controller="Board" asp-action="BoardIndex" class="btn btn-secondary">취소</a>
	</form>
</div>