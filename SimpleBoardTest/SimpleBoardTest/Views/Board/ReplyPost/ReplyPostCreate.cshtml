@model SimpleBoardTest.Models.ReplyPost

<div class="container mt-4">
	<h3>답글 작성</h3>
	<form asp-action="ReplyPostCreate" method="post">
		<input type="hidden" asp-for="ParentPostId" value="@ViewBag.ParentPostId" />
		<!-- (예시용) 로그인 세션에서 가져옴 -->
		<input type="hidden" asp-for="UserId" value="1" />

		<div class="mb-3">
			<label asp-for="Title" class="form-label">제목</label>
			<input asp-for="Title" class="form-control" />
		</div>

		<div class="mb-3">
			<label asp-for="Content" class="form-label">내용</label>
			<textarea asp-for="Content" class="form-control" rows="5"></textarea>
		</div>

		<button type="submit" class="btn btn-primary">작성</button>
		<a asp-controller="Board" asp-action="BoardIndex" class="btn btn-secondary">취소</a>
	</form>
</div>