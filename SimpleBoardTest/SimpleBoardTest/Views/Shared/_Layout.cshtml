@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"] - SimpleBoardTest</title>

	<!-- ✅ AdminLTE CSS -->
	<link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
	<link rel="stylesheet" href="~/dist/css/adminlte.min.css" />

	<!-- 사용자 정의 CSS -->
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="hold-transition sidebar-mini">
	<!-- ✅ AdminLTE 필수 wrapper -->
	<div class="wrapper">
		<!-- ✅ Navbar (원래 헤더 대신) -->
		<nav class="main-header navbar navbar-expand navbar-white navbar-light">
			<!-- 왼쪽 메뉴 -->
			<ul class="navbar-nav">
				<li class="nav-item">
					<a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a>
				</li>
				<li class="nav-item d-none d-sm-inline-block">
					<a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
				</li>
			</ul>

			<!-- 오른쪽 메뉴 -->
			<ul class="navbar-nav ml-auto">
				<li class="nav-item">
					<partial name="~/Views/Account/_LoginPartial.cshtml" />
				</li>
			</ul>
		</nav>

		<!-- ✅ Sidebar -->
		<aside class="main-sidebar sidebar-dark-primary elevation-4">
			<!-- 브랜드 로고 -->
			<a asp-controller="Home" asp-action="Index" class="brand-link">
				<span class="brand-text font-weight-light">SimpleBoardTest</span>
			</a>

			<!-- 사이드바 -->
			<div class="sidebar">
				<!-- 메뉴 -->
				<nav class="mt-2">
					<ul class="nav nav-pills nav-sidebar flex-column" data-weight="treeview" role="menu">
						<li class="nav-item">
							<a asp-controller="Home" asp-action="Index" class="nav-link">
								<i class="nav-icon fas fa-home"></i>
								<p>Home</p>
							</a>
						</li>
						<li class="nav-item">
							<a asp-controller="Home" asp-action="Privacy" class="nav-link">
								<i class="nav-icon fas fa-lock"></i>
								<p>Privacy</p>
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</aside>

		<!-- ✅ Content Wrapper -->
		<div class="content-wrapper">
			<!-- 콘텐츠 헤더 (옵션) -->
			<div class="content-header">
				<div class="container-fluid">
					<h1 class="m-0 text-dark">@ViewData["Title"]</h1>
				</div>
			</div>

			<!-- 실제 콘텐츠 -->
			<section class="content">
				<div class="container-fluid">
					@RenderBody()
				</div>
			</section>
		</div>

		<!-- ✅ Footer -->
		<footer class="main-footer">
			<strong>&copy; 2025 SimpleBoardTest</strong> All rights reserved.
		</footer>
	</div>
	<!-- / AdminLTE 필수 wrapper -->
	<!-- ✅ AdminLTE JS -->
	<script src="~/plugins/jquery/jquery.min.js"></script>
	<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="~/dist/js/adminlte.min.js"></script>

	<!-- ✅ 유효성 검사용 스크립트 추가 -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

	<!-- 사용자 정의 JS -->
	<script src="~/js/site.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
