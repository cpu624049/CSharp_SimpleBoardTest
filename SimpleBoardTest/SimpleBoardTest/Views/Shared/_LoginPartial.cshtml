@{
	var userId = Context.Session.GetInt32("UserId");
	var userName = Context.Session.GetString("UserName");
}

<ul class="navbar-nav">
	@if (userId != null)
	{
		<li class="nav-item">
			<span class="nav-link text-dark">👤 @userName 님</span>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">로그아웃</a>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="Register">회원가입</a>
		</li>
		<li class="nav-item">
			<a class="nav-link text-dark" asp-controller="Account" asp-action="Login">로그인</a>
		</li>
	}
</ul>